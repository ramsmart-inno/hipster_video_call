# Android Release Signing Configuration
# Copy this file to key.properties and fill in your actual values

# Keystore configuration
storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=release
storeFile=keystore/release.keystore

# Instructions:
# 1. Generate a keystore:
#    keytool -genkey -v -keystore android/app/keystore/release.keystore \
#            -alias release -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file: cp android/key.properties.example android/key.properties
# 3. Update the passwords above with your actual keystore passwords
# 4. Never commit key.properties to version control (it's in .gitignore)
#
# Note: For development/testing, you can use debug signing (no keystore needed)
